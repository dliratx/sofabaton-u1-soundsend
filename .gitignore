# Explicit publication allowlist. Research artifacts stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/NOTICES.md
!/requirements.txt
!/requirements-dev.txt
!/docs/
!/fixtures/
!/scripts/
!/firmware/
/firmware/*
!/firmware/*.c
!/firmware/*.h
!/firmware/*.S
!/firmware/*.ld
!/firmware/*.py
!/firmware/*.ps1
!/firmware/README.md
!/ble_probe.py
!/soundsend_control.py
!/u1_transport.py
!/u1_read.py
!/u1_debug.py
!/u1_arm_soundsend.py
!/u1_soundsend_profile.py
!/u1_ota_info.py
!/u1_ota_install.py
!/u1_delta_install.py
!/u1_complete_pending.py
!/u1_live_session.py
!/u1_exit_empty_staging.py
!/u1_rf_selftest.py
**/__pycache__/
*.pyc
*.pyo
.env
.env.*
*.pem
*.key
*.pfx
*.bin
*.elf
*.zip
*.log
